{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek v4 Flash (fast text worker)"
        },
        "glm-5.2": {
          "name": "GLM-5.2 (strong text worker)"
        },
        "qwen3-coder:480b": {
          "name": "Qwen3 Coder 480B (code worker)"
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash (vision worker)",
          "attachment": true
        },
        "gemma3:27b": {
          "name": "Gemma3 27B (vision worker)",
          "attachment": true
        },
        "qwen3.5:397b": {
          "name": "Qwen3.5 397B (vision, strong)",
          "attachment": true
        }
      }
    }
  }
}
